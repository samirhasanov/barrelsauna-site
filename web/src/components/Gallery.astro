---
import Photo from './Photo.astro';
interface Props { images: string[]; alt: string; group: string; layout?: 'masonry' | 'grid' }
const { images, alt, group, layout = 'masonry' } = Astro.props;
---
<div class:list={['gallery', layout]}>
  {images.map((n, i) => (
    <div class="g-item">
      <Photo name={n} alt={`${alt} — ${i + 1}`} lightbox={group} widths={[400, 700, 1000]} sizes="(max-width: 640px) 50vw, 33vw" />
    </div>
  ))}
</div>
<style>
  .gallery.masonry { columns: 3 260px; column-gap: 14px; }
  .gallery.masonry .g-item { break-inside: avoid; margin-bottom: 14px; }
  .gallery.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
  .gallery.grid .g-item :global(img) { aspect-ratio: 1; object-fit: cover; }
  .g-item { border-radius: 16px; overflow: hidden; background: var(--cream-2); }
  .g-item :global(img) { width: 100%; transition: transform 0.6s ease, filter 0.3s; }
  .g-item:hover :global(img) { transform: scale(1.03); }
  .g-item :global(a) { display: block; cursor: zoom-in; }
  @media (max-width: 640px) { .gallery.masonry { columns: 2; column-gap: 10px; } .gallery.masonry .g-item { margin-bottom: 10px; } }
</style>
