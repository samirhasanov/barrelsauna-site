---
import Crumbs from './Crumbs.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { waLink, type Lang } from '../data/site';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  crumbs: { label: string; href?: string }[];
  eyebrow?: string;
  title: string;
  lede?: string | string[];
  image?: string;
  imageAlt?: string;
  waText?: string;
  cta?: boolean;
}
const { lang, crumbs, eyebrow, title, lede, image, imageAlt, waText, cta = true } = Astro.props;
const ui = t(lang);
const ledes = lede ? (Array.isArray(lede) ? lede : [lede]) : [];
---
<section class="page-hero">
  <div class="container">
    <Crumbs lang={lang} items={crumbs} />
    <div class:list={['ph-grid', { 'has-img': image }]}>
      <div class="stack">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1 class="h1" set:html={title} />
        {ledes.map((p) => <p class="lede">{p}</p>)}
        {cta && (
          <div class="btn-row">
            <a class="btn btn-wa" href={waLink(waText ?? ui.wa.default)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {ui.cta.consult}</a>
            <a class="btn btn-ghost" href="#sifaris">{ui.cta.order}</a>
          </div>
        )}
        <slot />
      </div>
      {image && (
        <div class="ph-img rounded">
          <Photo name={image} alt={imageAlt ?? title.replace(/<[^>]+>/g, '')} priority sizes="(max-width: 900px) 100vw, 46vw" class="cover" />
        </div>
      )}
    </div>
  </div>
</section>
<style>
  .ph-grid { display: grid; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .ph-grid:not(.has-img) { max-width: 860px; }
  .ph-grid.has-img { grid-template-columns: 1.05fr 1fr; }
  .ph-img { aspect-ratio: 5 / 4; box-shadow: var(--shadow-lg); }
  .ph-img :global(img) { width: 100%; height: 100%; }
  @media (max-width: 900px) { .ph-grid.has-img { grid-template-columns: 1fr; } .ph-img { order: -1; aspect-ratio: 16 / 10; } }
</style>
