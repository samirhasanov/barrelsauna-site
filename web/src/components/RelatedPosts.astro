---
import PostCard from './PostCard.astro';
import { postsFor } from '../lib/blog';
import { path } from '../data/routes';
import type { Lang } from '../data/site';
import { t } from '../i18n/ui';
interface Props { lang: Lang; keys: string[]; limit?: number }
const { lang, keys, limit = 3 } = Astro.props;
const ui = t(lang);
const all = await postsFor(lang);
const score = (p: (typeof all)[number]) => p.data.related.filter((k) => keys.includes(k)).length;
const posts = all.filter((p) => score(p) > 0).sort((a, b) => score(b) - score(a) || b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, limit);
const title = { az: 'Faydalı məqalələr', en: 'Helpful articles', ru: 'Полезные статьи' }[lang];
---
{posts.length > 0 && (
  <section class="section-sm">
    <div class="container">
      <div class="section-head split">
        <h2 class="h2">{title}</h2>
        <a class="link-arrow" href={path('blog', lang)}>{ui.cta.backToBlog}</a>
      </div>
      <div class="grid grid-3">{posts.map((p) => <PostCard post={p} lang={lang} />)}</div>
    </div>
  </section>
)}
