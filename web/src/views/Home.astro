<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cross-fading slideshows (hero project tile + interior tile)
  document.querySelectorAll<HTMLElement>('[data-slides]').forEach((box) => {
    const slides = [...box.querySelectorAll<HTMLElement>('.slide')];
    if (slides.length < 2 || reduce) return;
    const dots = [...box.querySelectorAll<HTMLElement>('.slide-dots span')];
    const interval = Number(box.dataset.interval || 5500);
    box.style.setProperty('--dur', `${interval}ms`);
    const badge = box.closest('.hero-media')?.querySelector<HTMLAnchorElement>('[data-badge]');
    let i = 0;
    const go = () => {
      slides[i].classList.remove('active');
      dots[i]?.classList.replace('on', 'done');
      i = (i + 1) % slides.length;
      if (i === 0) dots.forEach((d) => d.classList.remove('done'));
      slides[i].classList.add('active');
      if (dots[i]) { dots[i].classList.remove('on'); void dots[i].offsetWidth; dots[i].classList.add('on'); }
      const s = slides[i];
      if (badge && s.dataset.place) {
        badge.href = s.dataset.href!;
        badge.querySelector('[data-badge-place]')!.textContent = s.dataset.place;
        badge.querySelector('[data-badge-model]')!.textContent = s.dataset.model!;
        badge.classList.remove('swap'); void badge.offsetWidth; badge.classList.add('swap');
      }
    };
    let timer = window.setInterval(go, interval);
    document.addEventListener('visibilitychange', () => { clearInterval(timer); if (!document.hidden) timer = window.setInterval(go, interval); });
  });

  // Count-up stats
  const fmt = (v: number, sample: string) => {
    const sep = sample.match(/\d([ \u00a0,.])\d{3}/)?.[1];
    const s = String(v);
    return sep ? s.replace(/\B(?=(\d{3})+(?!\d))/g, sep) : s;
  };
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
    const orig = el.textContent || '';
    if (!/\d/.test(orig) || reduce) return;
    const re = /\d+(?:[ \u00a0,.]\d{3})*/g;
    const t0 = performance.now() + 900;
    const dur = 1400;
    const tick = (now: number) => {
      const p = Math.min(1, Math.max(0, (now - t0) / dur));
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = orig.replace(re, (m) => fmt(Math.round(Number(m.replace(/\D/g, '')) * e), m));
      if (p < 1) requestAnimationFrame(tick);
    };
    el.textContent = orig.replace(re, (m) => fmt(0, m));
    requestAnimationFrame(tick);
  });

  // Subtle parallax on the photo mosaic (pointer devices only)
  const media = document.querySelector<HTMLElement>('[data-parallax]');
  if (media && !reduce && matchMedia('(pointer: fine)').matches) {
    const tiles = [...media.querySelectorAll<HTMLElement>('[data-depth]')];
    media.closest('.hero')!.addEventListener('pointermove', (e) => {
      const r = media.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      tiles.forEach((t) => { const d = Number(t.dataset.depth); t.style.translate = `${x * d}px ${y * d}px`; });
    });
  }
</script>
