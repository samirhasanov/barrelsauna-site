---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import ModelCard from '../components/ModelCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import SocialVideos from '../components/SocialVideos.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, waLink, type Lang } from '../data/site';
import { ROUTES, path } from '../data/routes';
import { MODELS, OUTDOOR_BUILD } from '../data/models';
import { WOODS } from '../data/indoor';
import { PROJECTS } from '../data/projects';
import { t } from '../i18n/ui';
import { faqLd } from '../lib/schema';
import { ogImage } from '../lib/images';
import { postsFor } from '../lib/blog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const posts = (await postsFor(lang)).slice(0, 3);

const c = {
  az: {
    title: 'Barrel Sauna – Çöl Saunaları və Sauna Tikintisi, Bakı',
    desc: 'Barrel, kub, kabin, kotec çöl saunaları və daxili sauna tikintisi Azərbaycanda. Listvenica, lipa, Harvia və SAWO sobaları. 6 000 AZN-dən. WhatsApp: 010 101 06 36',
    eyebrow: 'Azərbaycanın ilk çöl sauna brendi',
    h1: 'Barrel, kub və daxili <em>saunaların</em> tikintisi',
    lede: 'Həyətiniz, bağ eviniz, villanız və ya oteliniz üçün ilboyu istifadəyə hazır saunalar. Suya davamlı listvenica, sağlam lipa ağacı və çoxtəbəqəli izolyasiya — Bakıdan bütün bölgələrə.',
    ctaModels: 'Modellərə baxın',
    stats: [['6', 'çöl sauna modeli'], ['2–20', 'nəfərlik tutum'], ['6 000', 'AZN-dən başlayaraq'], ['AZ', 'bütün bölgələrdə quraşdırma']],
    trust: ['Harvia və SAWO sobaları', 'Listvenica xarici üzlük', 'Lipa, kedr, abaşi interyer', 'Bakı və bütün bölgələr'],
    modelsEyebrow: 'Çöl saunaları',
    modelsTitle: 'Hər həyətə uyğun <em>model</em>',
    modelsLede: 'Klassik çəllək formasından tam SPA kompleksinə qədər — hər model fərdi ölçüdə, seçdiyiniz taxta və soba ilə hazırlanır.',
    indoorEyebrow: 'Daxili saunalar',
    indoorTitle: 'Evinizin istənilən otağı — <em>lüks sağlamlıq guşəsi</em>',
    indoorText: 'Ev, villa, otel və ya SPA mərkəzinizdə ayırdığınız otağı tam funksional premium saunaya çeviririk. Sauna otağın ölçüsünə və dizaynına uyğun sıfırdan yığılır, divarlar isə mineral daş yunu və nəmə davamlı membranla buxardan tam qorunur.',
    indoorCta: 'Daxili saunalara baxın',
    woodsLabel: 'Taxta seçimləri',
    buildEyebrow: 'Niyə Barrel Sauna',
    buildTitle: 'Azərbaycan iqliminə uyğun <em>düşünülmüş</em> konstruksiya',
    buildLede: 'Saunalarımız yağışlı, qarlı və yüksək rütubətli şəraitdə belə illərlə xidmət etmək üçün qurulur.',
    processEyebrow: 'Necə işləyirik',
    processTitle: 'İlk mesajdan <em>ilk buxara</em> qədər',
    steps: [
      ['Məsləhət', 'WhatsApp-da yazın və ya zəng edin. Ərazi, istifadəçi sayı, istək və büdcəni müzakirə edirik.'],
      ['Layihə', 'Model, ölçü, taxta, soba və dekoru birlikdə seçirik; lazım olduqda 3D vizualizasiya hazırlayırıq.'],
      ['İstehsal', 'Saunanı Bakıdakı istehsalatımızda seçilmiş materiallardan, çoxtəbəqəli izolyasiya ilə yığırıq.'],
      ['Quraşdırma', 'Bakıda və bütün bölgələrdə quraşdırır, sobanı qoşur və istifadə qaydalarını izah edirik.'],
    ],
    projEyebrow: 'Layihələrimizdən',
    projTitle: 'Qəbələdən İlisuya — <em>real layihələr</em>',
    shopEyebrow: 'Sobalar və aksesuarlar',
    shopTitle: 'Harvia, SAWO və Saunabee — <em>hamısı bir yerdə</em>',
    shopText: 'Saunanın ürəyi sobadır. Odun və elektrik sobalarını, idarəetmə panellərini, vedrə, çömçə, termometr, işıqlandırma və digər aksesuarları dünya brendlərindən təqdim edir və quraşdırırıq.',
    moreEyebrow: 'Digər həllər',
    moreTitle: 'Sauna ilə yanaşı <em>daha çoxu</em>',
    blogEyebrow: 'Bloq',
    blogTitle: 'Sauna haqqında <em>faydalı</em> yazılar',
    faq: [
      { q: 'Çöl saunası neçəyə başa gəlir?', a: 'Təxmini qiymətlər: Barrel və Kub sauna 6 000 – 12 000 AZN, Oval və Kabin sauna 8 000 – 15 000 AZN, Kotec sauna 10 000 – 50 000 AZN, Outdoor SPA kompleks 15 000 – 45 000 AZN. Dəqiq qiymət ölçü, taxta, soba və əlavə seçimlərə görə hesablanır.' },
      { q: 'Hansı bölgələrdə sauna tikirsiniz?', a: 'Bakı, Abşeron və Azərbaycanın bütün bölgələrində. Qəbələ, Qax (İlisu), İsmayıllı və digər bölgələrdə tamamlanmış layihələrimiz var.' },
      { q: 'Çöl saunasından qışda istifadə etmək olarmı?', a: 'Bəli. Suya davamlı listvenica üzlük, mineral daş yunu və membrandan ibarət çoxtəbəqəli izolyasiya və ikiqat qorunan dam sayəsində saunalar ilboyu istifadə üçün nəzərdə tutulub.' },
      { q: 'Evdə daxili sauna tikmək mümkündürmü?', a: 'Bəli. Ev, villa, otel və ya SPA-da ayırdığınız istənilən otaqda, ölçüyə uyğun daxili sauna yığırıq. Divarlar xüsusi izolyasiya sistemi ilə buxar və rütubətdən qorunur.' },
      { q: 'Soba və aksesuarları da siz təmin edirsiniz?', a: 'Bəli. Harvia, SAWO və Saunabee məhsullarını — odun və elektrik sobalarını, idarəetmə panellərini və aksesuarları təqdim edir və quraşdırırıq.' },
    ],
  },
  en: {
    title: 'Barrel Sauna – Outdoor Saunas & Sauna Construction in Baku',
    desc: 'Barrel, cube, cabin and cottage outdoor saunas and indoor sauna construction in Azerbaijan. Larch, linden, Harvia & SAWO heaters. From 6,000 AZN.',
    eyebrow: 'Azerbaijan’s first outdoor sauna brand',
    h1: 'Barrel, cube & indoor <em>saunas</em>, built in Azerbaijan',
    lede: 'Year-round saunas for your garden, country house, villa or hotel. Water-resistant larch, healthy linden wood and multilayer insulation — delivered from Baku to every region.',
    ctaModels: 'Explore models',
    stats: [['6', 'outdoor models'], ['2–20', 'people capacity'], ['6,000', 'AZN starting price'], ['AZ', 'installed nationwide']],
    trust: ['Harvia & SAWO heaters', 'Larch exterior cladding', 'Linden, cedar, abachi interiors', 'Baku and all regions'],
    modelsEyebrow: 'Outdoor saunas',
    modelsTitle: 'A <em>model</em> for every garden',
    modelsLede: 'From the classic barrel to a full spa complex — every model is made to size, with the wood and heater of your choice.',
    indoorEyebrow: 'Indoor saunas',
    indoorTitle: 'Turn any room into a <em>luxury wellness corner</em>',
    indoorText: 'We transform a room in your home, villa, hotel or spa into a fully functional premium sauna. It is built from scratch to fit the room, while mineral stone wool and a moisture-resistant membrane fully protect your walls from steam.',
    indoorCta: 'Explore indoor saunas',
    woodsLabel: 'Wood options',
    buildEyebrow: 'Why Barrel Sauna',
    buildTitle: 'Construction <em>engineered</em> for Azerbaijan’s climate',
    buildLede: 'Our saunas are built to serve for years — even in rain, snow and high humidity.',
    processEyebrow: 'How we work',
    processTitle: 'From the first message to the <em>first steam</em>',
    steps: [
      ['Consultation', 'Message us on WhatsApp or call. We discuss the site, number of users, wishes and budget.'],
      ['Design', 'We choose model, size, wood, heater and décor together, with a 3D visualisation when needed.'],
      ['Production', 'We build the sauna in our Baku workshop from selected materials with multilayer insulation.'],
      ['Installation', 'We install in Baku and all regions, connect the heater and explain how to use it.'],
    ],
    projEyebrow: 'Our projects',
    projTitle: 'From Gabala to Ilisu — <em>real projects</em>',
    shopEyebrow: 'Heaters & accessories',
    shopTitle: 'Harvia, SAWO and Saunabee — <em>all in one place</em>',
    shopText: 'The heater is the heart of a sauna. We supply and install wood-burning and electric heaters, control panels, buckets, ladles, thermometers, lighting and more from world-leading brands.',
    moreEyebrow: 'More solutions',
    moreTitle: 'Beyond the <em>sauna</em>',
    blogEyebrow: 'Blog',
    blogTitle: 'Helpful <em>sauna</em> guides',
    faq: [
      { q: 'How much does an outdoor sauna cost?', a: 'Approximate prices: Barrel and Cube sauna 6,000 – 12,000 AZN, Oval and Cabin sauna 8,000 – 15,000 AZN, Cottage sauna 10,000 – 50,000 AZN, Outdoor spa complex 15,000 – 45,000 AZN. The exact price depends on size, wood, heater and extras.' },
      { q: 'Which regions do you work in?', a: 'Baku, Absheron and every region of Azerbaijan. We have completed projects in Gabala, Gakh (Ilisu), Ismayilli and more.' },
      { q: 'Can an outdoor sauna be used in winter?', a: 'Yes. Water-resistant larch cladding, multilayer insulation (mineral stone wool + membrane) and a double-protected roof make our saunas suitable for year-round use.' },
      { q: 'Can you build a sauna inside my house?', a: 'Yes. We build made-to-measure indoor saunas in any room of a home, villa, hotel or spa, with a dedicated insulation system that protects the walls from steam and humidity.' },
      { q: 'Do you supply heaters and accessories?', a: 'Yes. We supply and install Harvia, SAWO and Saunabee products — wood-burning and electric heaters, control panels and accessories.' },
    ],
  },
  ru: {
    title: 'Barrel Sauna – бани-бочки и уличные сауны в Баку',
    desc: 'Сауны-бочки, кубы, кабины, коттеджи и сауны в доме под ключ в Азербайджане. Лиственница, липа, печи Harvia и SAWO. От 6 000 AZN. WhatsApp.',
    eyebrow: 'Первый бренд уличных саун в Азербайджане',
    h1: 'Строительство саун: <em>бочки</em>, кубы и сауны в доме',
    lede: 'Сауны для двора, дачи, виллы или отеля, готовые к использованию круглый год. Влагостойкая лиственница, здоровая липа и многослойное утепление — от Баку до любого региона.',
    ctaModels: 'Смотреть модели',
    stats: [['6', 'моделей уличных саун'], ['2–20', 'человек вместимость'], ['6 000', 'AZN — цены от'], ['AZ', 'монтаж по всей стране']],
    trust: ['Печи Harvia и SAWO', 'Обшивка из лиственницы', 'Липа, кедр, абаши внутри', 'Баку и все регионы'],
    modelsEyebrow: 'Уличные сауны',
    modelsTitle: '<em>Модель</em> для любого участка',
    modelsLede: 'От классической бочки до полноценного SPA-комплекса — каждая модель изготавливается по размеру, с выбранной вами древесиной и печью.',
    indoorEyebrow: 'Сауны в доме',
    indoorTitle: 'Любая комната — <em>роскошный уголок здоровья</em>',
    indoorText: 'Превращаем комнату в доме, вилле, отеле или SPA в полноценную премиальную сауну. Сауна собирается с нуля под размер помещения, а минеральная вата и влагостойкая мембрана полностью защищают стены от пара.',
    indoorCta: 'Смотреть сауны в доме',
    woodsLabel: 'Варианты древесины',
    buildEyebrow: 'Почему Barrel Sauna',
    buildTitle: 'Конструкция, <em>продуманная</em> для климата Азербайджана',
    buildLede: 'Наши сауны служат годами — даже в дождь, снег и при высокой влажности.',
    processEyebrow: 'Как мы работаем',
    processTitle: 'От первого сообщения до <em>первого пара</em>',
    steps: [
      ['Консультация', 'Напишите в WhatsApp или позвоните. Обсудим участок, число гостей, пожелания и бюджет.'],
      ['Проект', 'Вместе выбираем модель, размер, дерево, печь и декор; при необходимости делаем 3D-визуализацию.'],
      ['Производство', 'Собираем сауну на нашем производстве в Баку из отборных материалов с многослойным утеплением.'],
      ['Монтаж', 'Устанавливаем в Баку и во всех регионах, подключаем печь и объясняем правила пользования.'],
    ],
    projEyebrow: 'Наши проекты',
    projTitle: 'От Габалы до Илису — <em>реальные проекты</em>',
    shopEyebrow: 'Печи и аксессуары',
    shopTitle: 'Harvia, SAWO и Saunabee — <em>всё в одном месте</em>',
    shopText: 'Сердце сауны — печь. Поставляем и устанавливаем дровяные и электрические печи, пульты управления, шайки, ковши, термометры, освещение и другие аксессуары мировых брендов.',
    moreEyebrow: 'Другие решения',
    moreTitle: 'Не только <em>сауна</em>',
    blogEyebrow: 'Блог',
    blogTitle: 'Полезные статьи <em>о саунах</em>',
    faq: [
      { q: 'Сколько стоит уличная сауна?', a: 'Ориентировочные цены: бочка и куб — 6 000 – 12 000 AZN, овальная и кабина — 8 000 – 15 000 AZN, коттедж — 10 000 – 50 000 AZN, уличный SPA-комплекс — 15 000 – 45 000 AZN. Точная цена зависит от размера, дерева, печи и опций.' },
      { q: 'В каких регионах вы работаете?', a: 'Баку, Абшерон и все регионы Азербайджана. У нас есть готовые проекты в Габале, Гахе (Илису), Исмаиллы и других районах.' },
      { q: 'Можно ли пользоваться уличной сауной зимой?', a: 'Да. Влагостойкая лиственница, многослойное утепление (минвата + мембрана) и двойная защита крыши позволяют пользоваться сауной круглый год.' },
      { q: 'Можно ли построить сауну в доме?', a: 'Да. Собираем сауны по размеру в любой комнате дома, виллы, отеля или SPA, с системой утепления, защищающей стены от пара и влаги.' },
      { q: 'Вы поставляете печи и аксессуары?', a: 'Да. Поставляем и устанавливаем продукцию Harvia, SAWO и Saunabee — дровяные и электрические печи, пульты и аксессуары.' },
    ],
  },
}[lang];

const more = [
  { key: 'container', img: 'container-2', name: { az: 'Konteyner sauna və jakuzi', en: 'Container sauna & jacuzzi', ru: 'Сауна-контейнер с джакузи' } },
  { key: 'jacuzzi', img: 'hottub-2', name: { az: 'Jakuzi və isti-soyuq vanna', en: 'Hot tubs & jacuzzi', ru: 'Джакузи и купели' } },
  { key: 'portable', img: 'portable-1', name: { az: 'Daşınabilən mobil sauna', en: 'Portable mobile sauna', ru: 'Мобильная сауна' } },
  { key: 'construction', img: 'render-6', name: { az: 'Sauna tikintisi xidməti', en: 'Sauna construction service', ru: 'Строительство саун' } },
] as const;

const featured = PROJECTS.slice(0, 4);
const bandText = {
  az: { title: 'Qarda, yağışda, <em>ilin dörd fəslində</em>', text: 'Suya davamlı listvenica, çoxtəbəqəli izolyasiya və ikiqat qorunan dam — saunanız havadan asılı olmadan hər gün istiyə hazırdır.' },
  en: { title: 'In snow, in rain, <em>in every season</em>', text: 'Water-resistant larch, multilayer insulation and a double-protected roof — your sauna is ready to heat up every day, whatever the weather.' },
  ru: { title: 'В снег, в дождь, <em>в любое время года</em>', text: 'Влагостойкая лиственница, многослойное утепление и двойная защита крыши — ваша сауна готова к растопке каждый день, в любую погоду.' },
}[lang];

// Hero slideshow — real projects
const heroSlides = PROJECTS.slice(0, 4).map((p) => ({ img: p.images[0], place: p.place[lang], model: p.modelName[lang], href: `${path('projects', lang)}#${p.id}` }));

// Split the headline into words for the staggered reveal; the <em> word gets a hand-drawn swash
let wi = 0;
const animatedH1 = c.h1
  .split(/(<em>.*?<\/em>)/)
  .flatMap((chunk) => {
    const em = chunk.match(/^<em>(.*)<\/em>$/);
    if (em) return [`<span class="w"><em><span style="--i:${wi++}">${em[1]}</span><svg class="swash" viewBox="0 0 220 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 10 C 55 2, 150 2, 217 8" /></svg></em></span>`];
    return chunk.split(/\s+/).filter(Boolean).map((w) => `<span class="w"><span style="--i:${wi++}">${w}</span></span>`);
  })
  .join(' ');
const og = await ogImage('proj-ilisu-cube-3');
const websiteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Barrel Sauna', url: `${SITE.url}/`, inLanguage: lang };
---
<Base lang={lang} title={c.title} description={c.desc} alternates={ROUTES.home} image={og} jsonLd={[websiteLd, faqLd(c.faq)]}>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow enter" style="--d:0">{c.eyebrow}</span>
        <h1 class="display headline" set:html={animatedH1} />
        <p class="lede enter" style="--d:5">{c.lede}</p>
        <div class="btn-row enter" style="--d:6">
          <a class="btn btn-wa" href={waLink(ui.wa.default)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {ui.cta.whatsapp}</a>
          <a class="btn btn-ghost" href="#modeller">{c.ctaModels} <Icon name="arrow" /></a>
        </div>
        <dl class="stats enter" style="--d:7">
          {c.stats.map(([n, l]) => <div><dt data-count>{n}</dt><dd>{l}</dd></div>)}
        </dl>
      </div>
      <div class="hero-media" data-parallax>
        <div class="hm hm-1 rounded" data-slides>
          {heroSlides.map((sl, i) => (
            <div class:list={['slide', { active: i === 0 }]} data-place={sl.place} data-model={sl.model} data-href={sl.href}>
              <Photo name={sl.img} alt={`${sl.model} — ${sl.place}`} priority={i === 0} loading={i === 0 ? 'eager' : 'lazy'} widths={[500, 800, 1000]} sizes="(max-width: 900px) 60vw, 30vw" class="cover" />
            </div>
          ))}
          <div class="steam" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          <div class="slide-dots" aria-hidden="true">{heroSlides.map((_, i) => <span class:list={{ on: i === 0 }}><b></b></span>)}</div>
        </div>
        <div class="hm hm-2 rounded" data-depth="14"><Photo name="barrel-3" alt={MODELS[0].name[lang]} priority widths={[400, 700]} sizes="(max-width: 900px) 40vw, 20vw" class="cover" /></div>
        <div class="hm hm-3 rounded" data-depth="-10" data-slides data-interval="4200">
          {['wood-termo-lipa-2', 'render-1', 'wood-kedr-1'].map((n, i) => (
            <div class:list={['slide', { active: i === 0 }]}><Photo name={n} alt={c.indoorEyebrow} widths={[400, 700]} sizes="(max-width: 900px) 40vw, 20vw" class="cover" /></div>
          ))}
        </div>
        <a class="hm-badge" href={heroSlides[0].href} data-badge>
          <img src="/brand/mark-dark.webp" alt="" width="40" height="40" />
          <span><span data-badge-place>{heroSlides[0].place}</span><br /><b data-badge-model>{heroSlides[0].model}</b></span>
        </a>
      </div>
    </div>
    <div class="trust" aria-label={c.eyebrow}>
      <div class="marquee">
        {[0, 1].map((k) => (
          <div class="marquee-track" aria-hidden={k === 1 ? 'true' : undefined}>
            {[...c.trust, ...c.trust].map((x) => <span><Icon name="check" size={16} /> {x}<i class="sep">✦</i></span>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MODELS -->
  <section class="section" id="modeller">
    <div class="container">
      <div class="section-head split reveal">
        <div class="stack-sm">
          <span class="eyebrow">{c.modelsEyebrow}</span>
          <h2 class="h2" set:html={c.modelsTitle} />
          <p class="lede">{c.modelsLede}</p>
        </div>
        <a class="link-arrow" href={path('outdoor', lang)}>{ui.nav.allModels}</a>
      </div>
      <div class="grid grid-3">
        {MODELS.map((m) => <div class="reveal"><ModelCard m={m} lang={lang} /></div>)}
      </div>
      <p class="small muted price-note">* {ui.labels.priceNote}</p>
    </div>
  </section>

  <!-- CINEMATIC BAND -->
  <section class="band" aria-label={bandText.title}>
    <div class="band-img"><Photo name="proj-qabala-barrel-1" alt={`${PROJECTS[4].title[lang]} — ${PROJECTS[4].place[lang]}`} widths={[800, 1080]} sizes="100vw" class="cover" /></div>
    <div class="container band-inner">
      <p class="band-kicker reveal"><Icon name="snow" size={16} /> {PROJECTS[4].place[lang]} · {PROJECTS[4].modelName[lang]}</p>
      <h2 class="display band-title reveal" set:html={bandText.title} />
      <p class="band-text reveal">{bandText.text}</p>
