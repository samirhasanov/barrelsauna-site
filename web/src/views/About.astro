---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, type Lang } from '../data/site';
import { ROUTES, path } from '../data/routes';
import { t } from '../i18n/ui';
import { ogImage } from '../lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const c = {
  az: {
    title: 'Haqqımızda – Barrel Sauna, Azərbaycanın İlk Çöl Sauna Brendi',
    desc: 'Barrel Sauna — Azərbaycanın ilk çöl saunalarını inşa edən şirkət. Çöl və daxili saunaların, SPA komplekslərinin layihələndirilməsi, istehsalı və quraşdırılması.',
    eyebrow: 'Haqqımızda',
    h1: 'Azərbaycanın ilk <em>çöl sauna</em> brendi',
    lede: [
      'Barrel Sauna Azərbaycanın ilk çöl saunalarını inşa edən şirkətdir. Açıq hava saunalarının hazırlanması, barrel, kub, kabin və kotec saunalar, daxili sauna tikintisi, hot tub, jakuzi və SPA kompleksləri üzrə ixtisaslaşmış komandayıq.',
      'Sauna tikintisi və yığılması ilə yanaşı Harvia, SAWO, Teplodar, TMF və Fanlan sobalarını və aksesuarlarını təqdim edir və quraşdırırıq.',
    ],
    valuesTitle: 'Bizim üçün vacib olanlar',
    values: [
      ['leaf', 'Təbii materiallar', 'Listvenica, lipa, kedr, abaşi — sağlamlıq və uzunömürlülük üçün seçilmiş ağaclar.'],
      ['shield', 'Dayanıqlı konstruksiya', 'Çoxtəbəqəli izolyasiya, membran, tənzimlənən metal kəmərlər və ikiqat qorunan dam.'],
      ['pencil', 'Fərdi yanaşma', 'Hər layihə yerinizə, istəyinizə və büdcənizə uyğun hazırlanır.'],
      ['truck', 'Bütün Azərbaycan', 'İstehsalatımız Bakıdadır, quraşdırmanı bütün bölgələrdə edirik.'],
    ],
    whereTitle: 'Biz haradayıq',
    whereText: 'İstehsalatımız və anbarımız Bakı şəhəri, Nərimanov rayonu, Əhməd Rəcəbli 1/25 ünvanında yerləşir. Bütün bölgələrə sauna tikintisi və quraşdırma xidməti göstəririk — istər şəxsi istifadə, istərsə də turizm obyektləri üçün.',
  },
  en: {
    title: 'About Barrel Sauna – Azerbaijan’s First Outdoor Sauna Brand',
    desc: 'Barrel Sauna built Azerbaijan’s first outdoor saunas. Design, production and installation of outdoor and indoor saunas and spa complexes.',
    eyebrow: 'About us',
    h1: 'Azerbaijan’s first <em>outdoor sauna</em> brand',
    lede: [
      'Barrel Sauna is the company that built Azerbaijan’s first outdoor saunas. We specialise in outdoor saunas — barrel, cube, cabin and cottage — indoor sauna construction, hot tubs, jacuzzis and spa complexes.',
      'Alongside sauna construction we supply and install Harvia, SAWO, Teplodar, TMF and Fanlan heaters and accessories.',
    ],
    valuesTitle: 'What matters to us',
    values: [
      ['leaf', 'Natural materials', 'Larch, linden, cedar, abachi — woods chosen for health and longevity.'],
      ['shield', 'Durable construction', 'Multilayer insulation, membrane, adjustable metal bands and a double-protected roof.'],
      ['pencil', 'Personal approach', 'Every project fits your site, wishes and budget.'],
      ['truck', 'All of Azerbaijan', 'Our workshop is in Baku; we install in every region.'],
    ],
    whereTitle: 'Where we are',
    whereText: 'Our workshop and warehouse are at 1/25 Ahmad Rajabli St, Narimanov district, Baku. We build and install saunas in every region — for private homes and hospitality businesses alike.',
  },
  ru: {
    title: 'О компании Barrel Sauna – первый бренд уличных саун в Азербайджане',
    desc: 'Barrel Sauna построила первые уличные сауны в Азербайджане. Проектирование, производство и монтаж уличных саун, саун в доме и SPA-комплексов.',
    eyebrow: 'О нас',
    h1: 'Первый бренд <em>уличных саун</em> в Азербайджане',
    lede: [
      'Barrel Sauna — компания, построившая первые уличные сауны в Азербайджане. Мы специализируемся на уличных саунах — бочках, кубах, кабинах и коттеджах, — строительстве саун в доме, чанах, джакузи и SPA-комплексах.',
      'Помимо строительства саун поставляем и устанавливаем печи и аксессуары Harvia, SAWO, Teplodar, TMF и Fanlan.',
    ],
    valuesTitle: 'Что для нас важно',
    values: [
      ['leaf', 'Натуральные материалы', 'Лиственница, липа, кедр, абаши — древесина для здоровья и долговечности.'],
      ['shield', 'Надёжная конструкция', 'Многослойное утепление, мембрана, регулируемые стяжки и двойная защита крыши.'],
      ['pencil', 'Индивидуальный подход', 'Каждый проект — под ваш участок, пожелания и бюджет.'],
      ['truck', 'Весь Азербайджан', 'Производство в Баку, монтаж во всех регионах.'],
    ],
    whereTitle: 'Где мы находимся',
    whereText: 'Производство и склад: г. Баку, Наримановский район, ул. Ахмеда Раджабли 1/25. Строим и устанавливаем сауны во всех регионах — для частных клиентов и туристических объектов.',
  },
}[lang];
const og = await ogImage('proj-ismayilli-cottage-3');
---
<Base lang={lang} title={c.title} description={c.desc} alternates={ROUTES.about} image={og}>
  <PageHero lang={lang} crumbs={[{ label: ui.nav.about }]} eyebrow={c.eyebrow} title={c.h1} lede={c.lede} image="proj-ismayilli-cottage-3" />
  <section class="section bg-forest">
    <div class="container">
      <h2 class="h2" style="margin-bottom:32px">{c.valuesTitle}</h2>
      <div class="grid grid-4">
        {c.values.map(([ic, h, p]) => <div class="v"><Icon name={ic} size={26} /><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div class="stack">
        <h2 class="h2">{c.whereTitle}</h2>
        <p class="lede">{c.whereText}</p>
        <p><Icon name="pin" size={18} class="inl" /> {SITE.address[lang]}</p>
        <a class="link-arrow" href={path('contact', lang)}>{ui.nav.contact}</a>
      </div>
      <div class="rounded ratio-16-10"><Photo name="proj-qabala-spa-1" alt={c.whereTitle} class="cover" sizes="(max-width: 900px) 100vw, 45vw" /></div>
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
<style>
  .v { padding: 26px; border-radius: var(--radius); background: rgba(246,241,228,.05); border: 1px solid rgba(246,241,228,.12); display: grid; gap: 10px; align-content: start; }
  .v :global(svg) { color: var(--amber); }
  .v h3 { font-size: 1.12rem; font-weight: 750; }
  .v p { color: rgba(246,241,228,.75); font-size: .95rem; }
  :global(.inl) { display: inline-block; vertical-align: -3px; color: var(--wood); }
  .ratio-16-10 :global(img) { width: 100%; height: 100%; }
</style>
