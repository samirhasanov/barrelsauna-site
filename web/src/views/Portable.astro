---
<SolutionPage lang={lang} c={content[lang]} alternates={ROUTES.portable} url={path('portable', lang)} hero="barrel-2"
  gallery={['barrel-2', 'barrel-6', 'cube-3', 'oval-5', 'barrel-1', 'cube-1', 'barrel-5', 'oval-6']}
  preset="barrel" related={['barrel', 'cube', 'oval']} />
